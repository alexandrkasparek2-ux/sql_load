{
  "name": "cycling-coach-bot",
  "version": "0.1.0",
  "description": "Telegram bot acting as a cycling performance coach powered by Claude, Strava, WHOOP and a custom SQL dashboard.",
  "main": "dist/bot.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bot.js",
    "dev": "tsx watch src/bot.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "node-fetch": "^3.3.2",
    "pino": "^9.14.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
