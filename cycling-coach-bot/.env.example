# === Telegram ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# === Anthropic (Claude Sonnet 4.5) ===
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-5

# === Strava ===
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REDIRECT_URI=https://your-domain.example.com/oauth/strava/callback
# Random token you invent and pass when subscribing the Strava webhook.
# Webhook endpoint will be: https://your-domain/webhooks/strava
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Numeric subscription id returned by POST /push_subscriptions. If set, only
# events carrying this id are accepted; all others are 403'd.
STRAVA_WEBHOOK_SUBSCRIPTION_ID=

# === TrainingPeaks ===
TP_API_KEY=your_tp_api_key
TP_API_SECRET=your_tp_api_secret
TP_REDIRECT_URI=https://your-domain.example.com/oauth/trainingpeaks/callback

# === WHOOP ===
WHOOP_CLIENT_ID=your_whoop_client_id
WHOOP_CLIENT_SECRET=your_whoop_client_secret
WHOOP_REDIRECT_URI=https://your-domain.example.com/oauth/whoop/callback

# === Custom SQL Dashboard ===
CUSTOM_DASHBOARD_URL=https://sql-load-xnhd.vercel.app
CUSTOM_DASHBOARD_TOKEN=

# === Database ===
# For SQLite simply use a file path. For Postgres set a full URL (and swap driver).
DATABASE_URL=./data/coach.sqlite

# === Proactive monitoring ===
MONITORING_INTERVAL_HOURS=6
ENABLE_PROACTIVE_MONITORING=false

# === OAuth callback HTTP server ===
# If set, the bot also starts an HTTP server on this port that handles
# /oauth/<provider>/callback for Strava, WHOOP and TrainingPeaks.
OAUTH_CALLBACK_PORT=3000

# === Voice messages (OpenAI Whisper) ===
# Optional — set to enable audio/voice message support on Telegram.
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
# Leave empty to auto-detect; set to e.g. "en" or "cs" to force.
WHISPER_LANGUAGE=

# === Rate limiting (per Telegram user, in-memory) ===
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=20

# === Admin ===
# Numeric Telegram user id allowed to run /seedtoken for local testing.
ADMIN_TELEGRAM_ID=

# === Logging ===
LOG_LEVEL=info
LOG_PRETTY=false
