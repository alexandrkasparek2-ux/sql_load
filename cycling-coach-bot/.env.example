# === Telegram ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# === Anthropic (Claude Sonnet 4.5) ===
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-5

# === Strava ===
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REDIRECT_URI=https://your-domain.example.com/oauth/strava/callback

# === TrainingPeaks ===
TP_API_KEY=your_tp_api_key
TP_API_SECRET=your_tp_api_secret
TP_REDIRECT_URI=https://your-domain.example.com/oauth/trainingpeaks/callback

# === WHOOP ===
WHOOP_CLIENT_ID=your_whoop_client_id
WHOOP_CLIENT_SECRET=your_whoop_client_secret
WHOOP_REDIRECT_URI=https://your-domain.example.com/oauth/whoop/callback

# === Custom SQL Dashboard ===
CUSTOM_DASHBOARD_URL=https://sql-load-xnhd.vercel.app
CUSTOM_DASHBOARD_TOKEN=

# === Database ===
# For SQLite simply use a file path. For Postgres set a full URL (and swap driver).
DATABASE_URL=./data/coach.sqlite

# === Proactive monitoring ===
MONITORING_INTERVAL_HOURS=6
ENABLE_PROACTIVE_MONITORING=false
